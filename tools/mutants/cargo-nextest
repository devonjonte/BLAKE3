#!/usr/bin/env python3
"""cargo-nextest shim for mutation runs (check.py).

check.py puts this file's directory first on PATH for a mutation run, so
cargo-mutants' `cargo nextest run ...` arrives here. It does two things:

1. Fast-fail ordering (`MUTANTS_FAST_LIB=1`): when both `--lib` and `--tests`
   are requested, run the fast `--lib` unit tests first and only run `--tests`
   integration tests if `--lib` passes. A mutant killed by a millisecond unit
   test fails immediately instead of hanging behind a blocking integration test.
   When `MUTANTS_SAME_CODE` is active (Linux ELF hashing), a quick `nextest list`
   populates `.stat` for every binary first so `same-code` checks stay whole-suite.
2. Reach narrowing (`MUTANTS_REACH=1`): narrows the run with `-E` to the tests
   that ran the mutated lines (tools/tests/reach.py).

Every other invocation (list, --no-run) passes straight through.
"""
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(os.path.dirname(HERE))
sys.path.insert(0, os.path.join(ROOT, "tools", "tests"))


def real_nextest():
    """The cargo-nextest after this one on PATH."""
    for d in os.environ.get("PATH", "").split(os.pathsep):
        candidate = os.path.join(d, "cargo-nextest")
        if os.path.isfile(candidate) and os.path.realpath(candidate) != os.path.realpath(__file__):
            return candidate
    sys.exit("cargo-nextest: no real cargo-nextest on PATH after the shim")


def narrowed(args):
    """The filterset for the mutant in the worktree, or None for every test."""
    import reach
    tree = subprocess.run(["git", "rev-parse", "HEAD^{tree}"], capture_output=True, text=True, check=True).stdout.strip()
    if not os.path.exists(reach.map_path(tree)):
        return None
    reach._BASE["commit"] = tree
    base_tests, instrumented = reach.read_map(tree)
    diff = reach.hunks(tree)
    listed = list(base_tests)
    chosen, everything = reach.select(base_tests, instrumented, listed, diff)
    if everything:
        return None
    if not chosen:
        # No test ran a changed line: nothing can see the mutant. One test
        # runs so that cargo-mutants sees a passing run (a filterset that
        # matches nothing is an error to nextest), and the mutant survives,
        # as the whole suite would let it.
        t = sorted(listed)[0]
        return f"(binary_id(={t.split(' ', 1)[0]}) & test(={t.split(' ', 1)[1]}))"
    return " | ".join(f"(binary_id(={t.split(' ', 1)[0]}) & test(={t.split(' ', 1)[1]}))" for t in sorted(chosen))


def with_extra(args, extra):
    """Insert nextest flags before `--` (if present), else at the end."""
    if not extra:
        return list(args)
    at = args.index("--") if "--" in args else len(args)
    return [*args[:at], *extra, *args[at:]]


def list_command(real, args):
    """Build the `nextest list` command matching `args` (minus any `-- ...`)."""
    at = args.index("--") if "--" in args else len(args)
    return [real, "nextest", "list", *args[2:at]]


def phase_commands(real, args, expr):
    """Split a `--lib --tests` run into `[lib_cmd, tests_cmd]`."""
    extra = ["--no-tests=pass"] + (["-E", expr] if expr is not None else [])
    lib_args = [a for a in args if a != "--tests"]
    tests_args = [a for a in args if a != "--lib"]
    return [
        [real, *with_extra(lib_args, extra)],
        [real, *with_extra(tests_args, extra)],
    ]


def dispatch(args, env, real, run_cmd, exec_cmd, narrow_fn=narrowed):
    """Execute nextest for `args`, returning the exit status (or execing)."""
    is_run = len(args) >= 2 and args[0] == "nextest" and args[1] == "run" and "--no-run" not in args
    expr = None
    if is_run and env.get("MUTANTS_REACH") == "1":
        try:
            expr = narrow_fn(args)
        except Exception as error:  # a failure to narrow is no reason to misjudge: every test
            print(f"cargo-nextest shim: every test ({error})", file=sys.stderr)
            expr = None

    if is_run and env.get("MUTANTS_FAST_LIB") == "1" and "--lib" in args and "--tests" in args:
        if env.get("MUTANTS_SAME_CODE"):
            # Let test-runner record `.stat` for every binary (--lib and --tests)
            # so same-code hashing compares the entire test set, not --lib alone.
            run_cmd(list_command(real, args), stdout=subprocess.DEVNULL)
        lib_cmd, tests_cmd = phase_commands(real, args, expr)
        rc = run_cmd(lib_cmd)
        if rc != 0:
            return rc
        return run_cmd(tests_cmd)

    cmd = [real, *with_extra(args, ["-E", expr] if expr is not None else [])]
    exec_cmd(cmd)
    return 0


def main():
    real = real_nextest()

    def run_cmd(cmd, stdout=None):
        return subprocess.run(cmd, stdout=stdout).returncode

    def exec_cmd(cmd):
        os.execv(cmd[0], cmd)

    rc = dispatch(sys.argv[1:], os.environ, real, run_cmd, exec_cmd)
    sys.exit(rc)


if __name__ == "__main__":
    main()
