#!/bin/sh
# cargo's target runner for a mutation run's test binaries (check.py):
# each test process may hold MUTANTS_TEST_DATA_KIB of data (RLIMIT_DATA),
# its own cap, well under the builds' (check.py, test_limits).
ulimit -d "$MUTANTS_TEST_DATA_KIB" || exit 101
# Same code (check.py, SAME_CODE): nextest lists every test binary before
# it runs a test, each through this runner (twice: its tests, then its
# ignored ones). The shard's first build is the unmutated one, and its
# listing records each binary's file (inode, mtime, size) and hash
# (code_hash.py: every byte the loader maps); a later build's listing of
# a relinked binary records whether it still hashes so, and the
# baseline's own file is the baseline still. When every binary hashes as
# before, the mutant changed nothing this machine runs: its first test
# exits at once with MARKER, which check.py reads in the mutant's log,
# and no test runs. Any binary that differs, or was not relinked, runs
# the tests as ever.
state=$MUTANTS_SAME_CODE
if [ -n "$state" ]; then
	case " $* " in
	*" --list "*)
		name=$(basename "$1")
		file=$(stat -c '%i %.9Y %s' "$1") || exit 101
		if [ ! -f "$state/$name.base" ]; then
			hash=$(python3 "$MUTANTS_CODE_HASH" "$1") || exit 101
			echo "$file $hash" > "$state/$name.base"
			echo baseline > "$state/$name.now"
		elif [ "$file" = "$(cut -d' ' -f1-3 "$state/$name.base")" ]; then
			echo baseline > "$state/$name.now"
		elif [ "$(python3 "$MUTANTS_CODE_HASH" "$1")" = "$(cut -d' ' -f4 "$state/$name.base")" ]; then
			echo same > "$state/$name.now"
		else
			echo differs > "$state/$name.now"
		fi
		;;
	*)
		if ls "$state" | grep -q '\.now$' && ! cat "$state"/*.now | grep -qvx same; then
			echo "$MUTANTS_SAME_CODE_MARKER" >&2
			exit 99
		fi
		;;
	esac
fi
exec "$@"
