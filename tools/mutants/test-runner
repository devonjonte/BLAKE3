#!/bin/sh
# cargo's target runner for a mutation run's test binaries (check.py):
# each test process may hold MUTANTS_TEST_DATA_KIB of data (RLIMIT_DATA),
# its own cap, well under the builds' (check.py, test_limits).
ulimit -d "$MUTANTS_TEST_DATA_KIB" || exit 101
# Same code (check.py, SAME_CODE): nextest lists every test binary before
# it runs a test, each through this runner. The shard's first build is
# the unmutated one, and its listing records each binary's hash
# (code_hash.py: every byte the loader maps); each later build's listing
# records whether the binary still hashes so. When all of them do, the
# mutant changed nothing this machine runs: its first test exits at once
# with MARKER, which check.py reads in the mutant's log, and no test
# runs. Any binary that differs runs the tests as ever.
state=$MUTANTS_SAME_CODE
if [ -n "$state" ]; then
	case " $* " in
	*" --list "*)
		hash=$(python3 "$MUTANTS_CODE_HASH" "$1") || exit 101
		name=$(basename "$1")
		if [ ! -f "$state/$name.base" ]; then
			echo "$hash" > "$state/$name.base"
			echo baseline > "$state/$name.now"
		elif [ "$hash" = "$(cat "$state/$name.base")" ]; then
			echo same > "$state/$name.now"
		else
			echo differs > "$state/$name.now"
		fi
		;;
	*)
		if ls "$state" | grep -q '\.now$' && ! cat "$state"/*.now | grep -qvx same; then
			echo "$MUTANTS_SAME_CODE_MARKER" >&2
			exit 99
		fi
		;;
	esac
fi
exec "$@"
