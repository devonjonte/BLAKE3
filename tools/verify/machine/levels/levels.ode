// The tree of chaining values another way (an experiment beside hasher.ode's stack; Sam's design, November 12).
//
// The stack (push, merge) keeps one value a pending subtree, puts a parent where its left child was, and
// is merged when a value arrives, so its caller must hold back whatever might be the root.
// Here:
//   - a parent is written into memory of its own, never over its children: each level of the tree
//     has room for two values side by side, which are a parent's 64-byte block as they lie;
//   - a pair becomes its parent only when a third value arrives at its level: until then it may be
//     the root, which is hashed differently. So every chunk's value is added, the last one too, and
//     `lroot` makes the root.
//
// The levels: the count of values added (a word) at offset 0; level L's two places at offset
// 64 + 64 L, 32 bytes each; 54 levels; 3520 bytes. What each level holds follows from the count n:
// with q = (n + 1) >> L, nothing if q <= 1, one value if q is even, two if q is odd.

const CHUNK_START = 1
const CHUNK_END   = 2
const PARENT      = 4
const ROOT        = 8
const AVX512      = 5
const AVX2        = 4

extern compress_avx512/5  = "blake3_servil_compress_in_place_avx512"
extern compress_sse41/5   = "blake3_servil_compress_in_place_sse41"
extern hash_many_avx512/10 = "blake3_servil_hash_many_avx512"
extern hash_many_avx2/10   = "blake3_servil_hash_many_avx2"
extern hash_many_sse41/10  = "blake3_servil_hash_many_sse41"

def compress(cv, block, block_len, counter, flags) {
  if plat == AVX512 { compress_avx512(cv, block, block_len, counter, flags) }
  else              { compress_sse41(cv, block, block_len, counter, flags) }
}

def level_at(L) = lv + 64 + (L << 6)

// The value at t is added. The full levels from the bottom (k of them) each give their pair's parent to
// the level above, the highest first, so every parent is written where nothing needed lies; then t takes
// the bottom level's first place, or its second if one value was there.
def levels_add() {
  ln = u64[lv]
  q = ln + 1
  k = 0
  while q & 1 == 1 {
    if q == 1 { q = 0 }
    else {
      k = k + 1
      q = q >> 1
    }
  }
  j = 0
  if q != 0 { j = 1 }
  while k > 0 {
    dst = level_at(k) + (j << 5)
    src = level_at(k - 1)
    copy 32 dst <- key
    compress(dst, src, 64, 0, pf)
    j = 0
    k = k - 1
  }
  copy 32 level_at(0) + (j << 5) <- t
  u64[lv] = ln + 1
}

// The root of the values added (two or more), written at out; the levels are left as they are.
// From the bottom level up: a pair becomes its parent, which joins the level above as its last value (pr);
// a value left alone joins what is right of it (acc). The last parent made is the root.
def levels_root() {
  ln = u64[lv]
  m = ln
  q = ln + 1
  pw = 2
  base = lv + 64
  have_p = 0
  have_c = 0
  while m != 0 {
    h = 0
    if q > 1 { h = 1 + (q & 1) }
    single = 0
    f = pf
    if ln == pw { f = pf | ROOT }          // this level's pair is the whole tree
    if h == 2 {
      if have_p == 1 {
        copy 32 old <- pr
        single = old
      }
      copy 32 pr <- key
      compress(pr, base, 64, 0, f)
      have_p = 1
    } else {
      if h == 1 {
        if have_p == 1 {
          copy 32 blk <- base
          copy 32 blk + 32 <- pr
          copy 32 pr <- key
          compress(pr, blk, 64, 0, f)
        } else { single = base }
      } else {
        if have_p == 1 {
          single = pr
          have_p = 0
        }
      }
    }
    if single != 0 {
      if have_c == 1 {
        f = pf
        if m == 1 { f = pf | ROOT }        // the highest level: this parent is the root
        copy 32 blk <- single
        copy 32 blk + 32 <- acc
        copy 32 acc <- key
        compress(acc, blk, 64, 0, f)
      } else {
        copy 32 acc <- single
        have_c = 1
      }
    }
    m = m >> 1
    q = q >> 1
    pw = pw + pw
    base = base + 64
  }
  copy 32 out <- acc
}

fn ladd(lv, key, flags, plat, t)
{
  var pf = flags | PARENT
  var ln = 0
  var q = 0
  var k = 0
  var j = 0
  var dst = 0
  var src = 0
  levels_add()
  return ln + 1
}

fn lroot(out, lv, key, flags, plat)
{
  buf blk[64]
  buf pr[32]
  buf old[32]
  buf acc[32]
  var pf = flags | PARENT
  var ln = 0
  var m = 0
  var q = 0
  var pw = 0
  var base = 0
  var have_p = 0
  var have_c = 0
  var h = 0
  var single = 0
  var f = 0
  levels_root()
}

def fill_ptrs(base, shift, count) {
  i = 0
  while i < count {
    u64[ptrs + (i << 3)] = base + (i << shift)
    i = i + 1
  }
}

// The whole hash on the levels (hasher.ode's `hash` without its 32-chunk path): every chunk's value is
// added, the last one too; one chunk alone is the root itself.
fn hash2(out, input, len, key, flags, plat)
  reg p, rem, counter, i, n, key
{
  buf lv[3520]
  buf cvs[1024]
  buf ptrs[256]
  buf block[64]
  buf cv[32]
  buf blk[64]
  buf pr[32]
  buf old[32]
  buf acc[32]
  var p = input
  var rem = len
  var counter = 0
  var pf = flags | PARENT
  var i = 0
  var n = 0
  var t = 0
  var f = 0
  var ln = 0
  var q = 0
  var k = 0
  var j = 0
  var dst = 0
  var src = 0
  var m = 0
  var pw = 0
  var base = 0
  var have_p = 0
  var have_c = 0
  var h = 0
  var single = 0
  u64[lv] = 0

  // Whole chunks, up to sixteen at a time, while more than one chunk's bytes are left.
  while rem > 1024 {
    n = rem >> 10
    if n > 16 { n = 16 }
    fill_ptrs(p, 10, n)
    if plat == AVX512 { hash_many_avx512(ptrs, n, 16, key, counter, 1, flags, CHUNK_START, CHUNK_END, cvs) }
    else { if plat == AVX2 { hash_many_avx2(ptrs, n, 16, key, counter, 1, flags, CHUNK_START, CHUNK_END, cvs) }
           else            { hash_many_sse41(ptrs, n, 16, key, counter, 1, flags, CHUNK_START, CHUNK_END, cvs) } }
    p = p + (n << 10)
    rem = rem - (n << 10)
    i = 0
    while i < n {
      t = cvs + (i << 5)
      levels_add()
      i = i + 1
    }
    counter = counter + n
  }

  // What is left: the only chunk (it is the root), or the last one if bytes are left.
  var one = 0
  if counter == 0 { one = 1 }
  var tail = one
  if rem != 0 { tail = 1 }
  if tail == 1 {
    copy 32 cv <- key
    var first = CHUNK_START
    while rem > 64 {
      f = flags | first
      compress(cv, p, 64, counter, f)
      first = 0
      p = p + 64
      rem = rem - 64
    }
    var lastp = p
    if rem != 64 {
      for k8 in 0..8 { u64[block + (k8 << 3)] = 0 }
      var jj = 0
      while jj < rem {
        u8[block + jj] = u8[p + jj]
        jj = jj + 1
      }
      lastp = block
    }
    f = flags | first | CHUNK_END
    if one == 1 { f = f | ROOT }
    compress(cv, lastp, rem, counter, f)
  }
  if one == 1 { copy 32 out <- cv }
  else {
    if tail == 1 {
      t = cv
      levels_add()
    }
    levels_root()
  }
}
